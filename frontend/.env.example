# ---------------------------------------------------------------------------
# AI Job Tracker — frontend configuration (copy to .env.local for local dev).
# NEXT_PUBLIC_* values are inlined into the JS bundle at BUILD time.
# ---------------------------------------------------------------------------

# Option A — direct mode: the browser calls the API origin directly.
# Local dev: http://localhost:8000 (localhost:3000 and :8000 are same-site, cookies just work).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Option B — proxy mode (recommended in production): leave NEXT_PUBLIC_API_URL empty and
# set API_PROXY_TARGET; Next.js rewrites /api/* and /health to the backend, so the
# refresh-token cookie is first-party for the frontend's domain.
# NEXT_PUBLIC_API_URL=
# API_PROXY_TARGET=https://your-api.onrender.com
