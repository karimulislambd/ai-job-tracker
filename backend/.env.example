# ---------------------------------------------------------------------------
# AI Job Tracker — backend configuration. Copy to .env for local development.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# false = human-readable logs locally
LOG_JSON=true

# PostgreSQL. postgres:// and postgresql:// URLs are accepted and converted to asyncpg;
# Neon's ?sslmode=require&channel_binding=require is handled automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobtracker

# Auth. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Refresh-token cookie. Same-site deploys (frontend proxies /api, recommended): lax + secure.
# Direct cross-site deploys (frontend calls the API domain directly): none + secure.
COOKIE_SECURE=false
# lax | strict | none
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Comma-separated list of allowed browser origins (CORS + CSRF Origin check).
FRONTEND_ORIGIN=http://localhost:3000

# Optional Redis for rate limiting + stats cache. Leave empty to use in-memory fallbacks.
REDIS_URL=
# requests per window per IP on auth endpoints
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
STATS_CACHE_TTL_SECONDS=60

# LLM. Without a key, a deterministic offline heuristic produces analyses instead.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Background worker (runs inside the API process unless disabled).
RUN_WORKER_IN_API=true
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=4

# Demo mode (one-click demo login; demo users are deleted after DEMO_TTL_HOURS).
DEMO_ENABLED=true
DEMO_TTL_HOURS=24

MAX_UPLOAD_BYTES=5242880
